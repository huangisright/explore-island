rules_version = '2';
// 探索島：名單制
//   roster/{email}            學生名單（文件 id = 小寫 email）：老師能寫；學生輸入對的加入碼可以自己建一筆
//   config/join               加入碼 { code }，只有老師能讀寫
//   records/{uid}             學生本人的基本資料（email、姓名）
//   records/{uid}/units/{slug} 每一章的探索紀錄
// 學生：只有在名單上、而且是本人，才能寫；只能讀自己的。
// 老師：管理者／老師／檢視三層（見下方 role()）；都不改學生的紀錄。
//   staff/{email}             其他老師帳號 { role, name }，只有管理者能改
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    // 老師權限：kb5936 是主管理者（寫死、不能移除）；其他老師記在 staff/{email}，role = admin／teacher／viewer
    function isOwnerTeacher() { return verified() && myEmail() == 'kb5936@cnc.km.edu.tw'; }
    function staffDoc() { return /databases/$(db)/documents/staff/$(myEmail()); }
    function role() { return isOwnerTeacher() ? 'admin'
      : (verified() && exists(staffDoc()) ? get(staffDoc()).data.role : ''); }
    function isAdmin() { return role() == 'admin'; }
    function isTeacher() { return role() in ['admin', 'teacher']; }        // 管名單、加入碼
    function canView() { return role() in ['admin', 'teacher', 'viewer']; } // 看全班紀錄
    function rostered() { return verified() && exists(/databases/$(db)/documents/roster/$(myEmail())); }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // 加入碼：config/join 的 code，只有老師讀得到、改得到
    function joinCode() { return get(/databases/$(db)/documents/config/join).data.code; }

    match /roster/{email} {
      allow read: if canView() || (verified() && email == myEmail());
      allow create, update: if isTeacher()
        && request.resource.data.keys().hasOnly(['name', 'seat', 'cls', 'note', 'self']);
      // 學生第一次登入：輸入對的加入碼，才能用自己的 email 建一筆；之後要改找老師
      allow create: if verified() && email == myEmail()
        && exists(/databases/$(db)/documents/config/join)
        && request.resource.data.keys().hasOnly(['name', 'seat', 'cls', 'self', 'code'])
        && request.resource.data.code == joinCode()
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && request.resource.data.cls is string && request.resource.data.cls.size() <= 10
        && request.resource.data.seat is int
        && request.resource.data.self == true;
      allow delete: if isTeacher();
    }

    match /staff/{email} {
      allow read: if isAdmin() || (verified() && email == myEmail());
      allow create, update: if isAdmin() && email != 'kb5936@cnc.km.edu.tw'
        && request.resource.data.keys().hasOnly(['role', 'name'])
        && request.resource.data.role in ['admin', 'teacher', 'viewer'];
      allow delete: if isAdmin() && email != 'kb5936@cnc.km.edu.tw';
    }

    match /config/join {
      allow read, write: if isTeacher();
    }

    // 教材內容（空殼頁登入後才載入的那一包）：
    //   讀一章：名單上的學生，或老師帳號（管理者／老師／檢視）
    //   列出全部：只有老師帳號（上傳頁要看哪幾章已經放上去）
    //   寫入、刪除：只有管理者
    match /content/{slug} {
      allow get: if rostered() || canView();
      allow list: if canView();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['slug', 'title', 'head', 'body', 'updated'])
        && request.resource.data.slug == slug
        && request.resource.data.head is string
        && request.resource.data.body is string;
      allow delete: if isAdmin();
    }

    // ===== 報告島：章後延伸報告 =====
    //   ext/{chap}                         這一章的報告場次 { order:{班級:[uid…]}, now: 正在報告的 uid, nowCls, lock: 截止收件 }，老師寫
    //   ext/{chap}/subs/{uid}              學生的選題與繳交（名單上的人都看得到，方便看展示）
    //   ext/{chap}/subs/{uid}/img/{0|1|2}  海報照片（壓縮過的 JPEG，base64）
    //   ext/{chap}/grades/{uid}            老師評分與評語；show == true 之後學生本人才看得到
    //   ext/{chap}/peer/{target}_{rater}   同學互評；只有台上那一位正在報告時才能寫；老師與寫的人看得到
    function extDoc(chap) { return /databases/$(db)/documents/ext/$(chap); }
    function extOpen(chap) { return !exists(extDoc(chap)) || get(extDoc(chap)).data.get('lock', false) != true; }
    function myRoster() { return get(/databases/$(db)/documents/roster/$(myEmail())).data; }

    match /ext/{chap} {
      allow read: if rostered() || canView();
      allow create, update: if isTeacher() && chap.matches('g[789][ab]-[0-9]+')
        && request.resource.data.keys().hasOnly(['order', 'now', 'nowCls', 'lock', 'updated']);
      allow delete: if isTeacher();

      match /subs/{uid} {
        allow read: if rostered() || canView();
        allow create, update: if isOwner(uid) && rostered() && extOpen(chap)
          && request.resource.data.keys().hasOnly(['name', 'cls', 'seat', 'q', 'k', 'title', 'concl', 'link', 'n', 'thumb', 'drive', 'done', 'updated', 'doneAt'])
          && request.resource.data.name == myRoster().get('name', '')
          && request.resource.data.cls == myRoster().get('cls', '')
          && request.resource.data.seat == myRoster().get('seat', 0)
          && request.resource.data.k is string && request.resource.data.k.size() <= 10
          && request.resource.data.q is int && request.resource.data.q >= 0 && request.resource.data.q <= 5
          && request.resource.data.title is string && request.resource.data.title.size() <= 200
          && request.resource.data.concl is string && request.resource.data.concl.size() <= 120
          && request.resource.data.link is string && request.resource.data.link.size() <= 400
          && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n <= 3
          && request.resource.data.thumb is string && request.resource.data.thumb.size() < 120000
          && request.resource.data.drive is list && request.resource.data.drive.size() <= 3
          && request.resource.data.done is bool;
        allow delete: if (isOwner(uid) && extOpen(chap)) || isTeacher();

        match /img/{i} {
          allow read: if rostered() || canView();
          allow create, update: if isOwner(uid) && rostered() && extOpen(chap) && i in ['0', '1', '2']
            && request.resource.data.keys().hasOnly(['data', 'updated'])
            && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
          allow delete: if (isOwner(uid) && extOpen(chap)) || isTeacher();
        }
      }

      match /grades/{uid} {
        allow read: if canView() || (isOwner(uid) && resource.data.show == true);
        allow create, update: if isTeacher()
          && request.resource.data.keys().hasOnly(['s', 'comment', 'show', 'by', 'updated'])
          && request.resource.data.s is map
          && request.resource.data.comment is string && request.resource.data.comment.size() <= 1000
          && request.resource.data.show is bool;
        allow delete: if isTeacher();
      }

      match /peer/{pid} {
        allow get: if canView() || (signedIn() && pid.split('_')[1] == request.auth.uid);
        allow list: if canView();
        allow create, update: if rostered()
          && pid == request.resource.data.target + '_' + request.auth.uid
          && request.resource.data.keys().hasOnly(['target', 'rater', 'name', 'stars', 'comment', 'updated'])
          && request.resource.data.rater == request.auth.uid
          && request.resource.data.target != request.auth.uid
          && request.resource.data.name == myRoster().get('name', '')
          && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 3
          && request.resource.data.comment is string && request.resource.data.comment.size() <= 80
          && exists(extDoc(chap)) && get(extDoc(chap)).data.get('now', '') == request.resource.data.target;
        allow delete: if isTeacher();
      }
    }

    match /records/{uid} {
      allow read: if canView() || isOwner(uid);
      allow create, update: if isOwner(uid) && rostered()
        && request.resource.data.keys().hasOnly(['email', 'name', 'updated'])
        && request.resource.data.email == myEmail();
      allow delete: if false;

      match /units/{slug} {
        allow read: if canView() || isOwner(uid);
        allow create, update: if isOwner(uid) && rostered()
          && request.resource.data.keys().hasOnly(['data', 'updated', 'nd', 'n', 'qd', 'q', 'stampAt'])
          && request.resource.data.data is string
          && request.resource.data.data.size() < 60000;
        allow delete: if isOwner(uid);
      }
    }
  }
}
